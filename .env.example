# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Keys can be set here or pasted in the web UI (AI providers tab). A key saved
# in the web UI wins over the environment so a stale key can be replaced
# without restarting the server.

# OpenRouter (default). The legacy name is still supported for compatibility.
openRouterAPIKEY=your_key_here
# OPENROUTER_API_KEY=your_key_here

# Optional: override the LLM used for parsing/scoring per provider.
# Defaults come from src/llm/providers.ts.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=deepseek-chat
# MISTRAL_MODEL=mistral-small-latest
# XAI_MODEL=grok-3-mini
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional: set to "false" if your OpenRouter model rejects response_format.
# OPENROUTER_JSON_MODE=true

# Other providers. Uncomment and fill in the one you want to use.
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here
# DEEPSEEK_API_KEY=your_key_here
# MISTRAL_API_KEY=your_key_here
# XAI_API_KEY=your_key_here
# TOGETHER_API_KEY=your_key_here

# Optional: where Puppeteer reads your exported session cookies from.
# Defaults to ./cookies.json in the project root.
# JOBWRIGHT_COOKIES_PATH=./cookies.json

# Optional: override the SQLite database location.
# Defaults to ./jobwright.db in the project root.
# JOBWRIGHT_DB_PATH=./jobwright.db

# Optional: Telegram notifications for live apply runs.
# You can also save these from the web UI's Notifications tab; saved values win.
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: web API / SPA server settings.
# HOST=127.0.0.1
# PORT=3000
# Comma-separated origins allowed by CORS (the Vite dev server by default).
# CORS_ORIGIN=http://localhost:5173
# Where the server reads the parsed resume profile from.
# JOBWRIGHT_PROFILE_PATH=./profile.json

# Where the server keeps the original Markdown uploaded through the web UI.
# JOBWRIGHT_RESUME_PATH=./resume.md
