{
  "name": "jobwright",
  "version": "0.1.0",
  "description": "Self-hosted CLI that parses your resume, scores job postings with an LLM, and auto-applies to the ones that fit.",
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "dev:apply": "tsx watch src/cli/apply.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli/index.ts",
    "apply": "tsx src/cli/apply.ts",
    "test": "vitest run"
  },
  "keywords": [
    "job-search",
    "resume",
    "automation",
    "puppeteer",
    "cli",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "dotenv": "^17.4.2",
    "figlet": "^1.11.4",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "puppeteer": "^25.6.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.4.3"
  }
}
